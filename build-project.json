{
  "schema": 1,
  "adapter_api": 1,
  "project_id": "io.github.ispaure.bluehole",
  "name": "Blue Hole",
  "interpreter": {
    "darwin": ".venv/bin/python",
    "linux": ".venv/bin/python",
    "win32": ".venv/Scripts/python.exe"
  },
  "bridge": "Scripts/manager_bridge.py",
  "results": "test-results/build-manager",
  "capabilities": {
    "platforms": [
      "blender"
    ],
    "operations": [
      "Check",
      "Package",
      "Prepare GitHub release"
    ],
    "backends": {
      "blender": [
        "Local"
      ]
    },
    "providers": [
      "github"
    ]
  },
  "presets": {
    "Alpha validation": {
      "operation": "Check",
      "platform": "blender",
      "backend": "Local"
    },
    "Alpha installable package": {
      "operation": "Package",
      "platform": "blender",
      "backend": "Local"
    },
    "Alpha GitHub release preparation": {
      "operation": "Prepare GitHub release",
      "platform": "blender",
      "backend": "Local"
    }
  },
  "account_fields": {
    "github": {
      "reference": "auth.github_reference",
      "kind": "auth.github_kind"
    }
  }
}
