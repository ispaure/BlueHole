{
  "schema": 1,
  "adapter_api": 1,
  "project_id": "io.github.ispaure.bluehole",
  "name": "Blue Hole",
  "interpreter": {
    "darwin": ".venv/bin/python",
    "linux": ".venv/bin/python",
    "win32": ".venv/Scripts/python.exe"
  },
  "bridge": "Scripts/manager_bridge.py",
  "results": "test-results/build-manager",
  "capabilities": {
    "platforms": [
      "blender"
    ],
    "operations": [
      "Check",
      "Package",
      "Prepare GitHub release",
      "Reviewed GitHub draft"
    ],
    "backends": {
      "blender": [
        "Local"
      ]
    },
    "providers": [
      "github"
    ]
  },
  "presets": {
    "Alpha validation": {
      "operation": "Check",
      "platform": "blender",
      "backend": "Local"
    },
    "Alpha installable package": {
      "operation": "Package",
      "platform": "blender",
      "backend": "Local"
    },
    "Alpha GitHub release preparation": {
      "operation": "Prepare GitHub release",
      "platform": "blender",
      "backend": "Local"
    },
    "Portable contracts": {
      "operation": "Check",
      "platform": "blender",
      "backend": "Local",
      "suite": "portable.contracts"
    },
    "Supported Blender native acceptance": {
      "operation": "Check",
      "platform": "blender",
      "backend": "Local",
      "suite": "blender.integration"
    },
    "Reviewed GitHub draft": {
      "operation": "Reviewed GitHub draft",
      "platform": "blender",
      "backend": "Local",
      "suite": "release.acceptance"
    }
  },
  "account_fields": {
    "github": {
      "reference": "auth.github_reference",
      "kind": "auth.github_kind"
    }
  },
  "test_suites": [
    {
      "id": "portable.contracts",
      "label": "Portable contracts and pinned shared copy",
      "tier": "contracts",
      "platforms": [
        "blender"
      ],
      "operations": [
        "Check"
      ],
      "description": "Actual portable unittest cases; no native acceptance is implied."
    },
    {
      "id": "blender.integration",
      "label": "Blender 5.2.2 isolated enable and import",
      "tier": "native",
      "platforms": [
        "blender"
      ],
      "operations": [
        "Check"
      ],
      "description": "Requires an explicit supported binary and isolated user directories."
    },
    {
      "id": "package.inspection",
      "label": "Prepare and inspect exact installable package",
      "tier": "integration",
      "platforms": [
        "blender"
      ],
      "operations": [
        "Package"
      ],
      "description": "Complete portable gates, package allowlist and checksum verification."
    },
    {
      "id": "release.acceptance",
      "label": "Complete alpha release acceptance",
      "tier": "acceptance",
      "platforms": [
        "blender"
      ],
      "operations": [
        "Prepare GitHub release",
        "Reviewed GitHub draft"
      ],
      "description": "Complete portable, package, exact-package native and hosted gates. Cannot be narrowed."
    }
  ]
}
